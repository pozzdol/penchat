APP_NAME="PenChat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@your-domain"
MAIL_FROM_NAME="${APP_NAME}"
# Resend sends the sign-in codes. The transport ships with Laravel; the SDK is
# resend/resend-php. Two things have to be true or nothing arrives:
#   1. this key exists, from resend.com/api-keys
#   2. the domain in MAIL_FROM_ADDRESS is verified in Resend, with its DNS
#      records added. An unverified domain is rejected outright.
# Without a verified domain, onboarding@resend.dev works but can only send to
# the address that owns the Resend account.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Server-side. Read by PHP at runtime.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Browser-side. COMPILED INTO THE BUNDLE — changing these needs `bun run build`,
# not a server restart. Mixing these up with the block above is the documented
# failure #1 in AGENTS.md.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Web Push. Generate once with `php artisan push:vapid`, then never again:
# every browser out there holds a subscription bound to the public key, so a
# new pair silently stops every notification — no error, nothing arrives.
# Back the private key up the way APP_KEY is backed up.
#
# Deliberately not VITE_ prefixed. The public half reaches the browser through
# Inertia shared props, so rotating these needs no `bun run build`.
#
# VAPID_SUBJECT identifies the sender to the push services and must be a
# mailto: or https: URL; it falls back to APP_URL.
#
# Two more things have to be true or nothing arrives, and neither fails loudly:
# the site is served over HTTPS (service workers refuse plain HTTP outside
# localhost), and on iPhone the app has been added to the Home Screen — Safari
# does not deliver a push to a page in a tab.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:no-reply@your-domain"
